<li class="card" data-id="{{id}}" data-status="{{status}}" data-policy_type="{{policy_type}}" data-standard_body="{{standard_body}}" data-category="{{category}}" data-sector="{{sector}}" data-net="{{net}}" data-sdg="{{sdgAttr}}" data-tag="{{tagAttr}}" data-text="{{text}}">
<div class="card-head {{artClass}}">{{#hasThumb}}<img class="card-art" src="{{{thumbSrc}}}" alt="" loading="lazy">{{/hasThumb}}<div class="card-scrim"></div>
<p class="card-meta"><span class="card-meta-line"><span class="sr-only">Category: </span><a class="card-link" href="{{root}}index.html?category={{catQv}}" data-filter="category" data-value="{{category}}">{{categoryLabel}}</a></span><span class="card-meta-line"><span class="sr-only">Sector: </span>{{#sectorQv}}<a class="card-link" href="{{root}}index.html?sector={{sectorQv}}" data-filter="sector" data-value="{{sector}}">{{sectorLabel}}</a>{{/sectorQv}}{{^sectorQv}}{{sectorLabel}}{{/sectorQv}}</span></p>
<h3 class="card-title"><a href="{{root}}p/{{id}}/index.html">{{name}}</a></h3>
<p class="card-sub"><span class="card-sub-l"><span class="sr-only">Standards body: </span><a class="card-link" href="{{root}}index.html?standard_body={{sbQv}}" data-filter="standard_body" data-value="{{standard_body}}">{{standard_body}}</a></span><span class="card-sub-r"><span class="sr-only">Hedera publication: </span><a class="card-link" href="{{root}}index.html?net={{netQv}}" data-filter="net" data-value="{{net}}">{{netLabel}}</a></span></p></div>
<div class="card-body">
<p class="card-row"><span class="card-status st-{{status}}"><span class="sr-only">Status: </span><a class="card-link" href="{{root}}index.html?status={{statusQv}}" data-filter="status" data-value="{{status}}">{{status}}</a></span><span class="card-type"><span class="sr-only">Policy type: </span><a class="card-link" href="{{root}}index.html?policy_type={{typeQv}}" data-filter="policy_type" data-value="{{policy_type}}">{{policyTypeLabel}}</a></span></p>
<p class="desc card-desc">{{summary}}</p>
<div class="card-tags">{{#tags}}<a class="chip tag card-tag" href="{{root}}index.html?tag={{qv}}" data-filter="tag" data-value="{{value}}">#{{value}}</a>{{/tags}}</div></div>
<div class="card-actions">{{#githubUrl}}<a class="card-btn" href="{{{githubUrl}}}" target="_blank" rel="noopener noreferrer">View on Github<span class="sr-only"> (opens in a new tab)</span></a>{{/githubUrl}}{{^githubUrl}}<span class="card-btn" aria-disabled="true">View on Github</span>{{/githubUrl}}
<span class="card-import"><button type="button" class="card-btn" disabled aria-describedby="import-note-{{id}}">Import to Guardian</button><span id="import-note-{{id}}" class="card-note">Coming soon<span class="sr-only">: importing into Guardian from this page is not available yet</span></span></span></div></li>
