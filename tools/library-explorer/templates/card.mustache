<li class="card" data-id="{{id}}" data-status="{{status}}" data-policy_type="{{policy_type}}" data-standard_body="{{standard_body}}" data-category="{{category}}" data-sector="{{sector}}" data-net="{{net}}" data-sdg="{{sdgAttr}}" data-tag="{{tagAttr}}" data-text="{{text}}">
<div class="card-head {{artClass}}">{{#hasThumb}}<img class="card-art" src="{{{thumbSrc}}}" alt="" loading="lazy">{{/hasThumb}}<div class="card-scrim"></div>
<p class="card-meta"><span class="card-meta-line"><span class="sr-only">Category: </span><a class="card-link" href="{{root}}index.html?category={{catQv}}" data-filter="category" data-value="{{category}}">{{categoryLabel}}</a></span>{{#sectorQv}}<span class="card-meta-line"><span class="sr-only">Sector: </span><a class="card-link" href="{{root}}index.html?sector={{sectorQv}}" data-filter="sector" data-value="{{sector}}">{{sectorLabel}}</a></span>{{/sectorQv}}</p>
<h3 class="card-title"><a href="{{root}}p/{{id}}/index.html">{{name}}</a></h3>
<p class="card-sub">{{#hasSb}}<span class="card-sub-l"><span class="sr-only">Standards body: </span><a class="card-link" href="{{root}}index.html?standard_body={{sbQv}}" data-filter="standard_body" data-value="{{standard_body}}">{{standard_body}}</a></span>{{/hasSb}}<span class="card-sub-r"><span class="sr-only">Hedera publication: </span><a class="card-link" href="{{root}}index.html?net={{netQv}}" data-filter="net" data-value="{{net}}">{{netLabel}}</a></span></p></div>
<div class="card-body">
<p class="card-row"><span class="card-status st-{{status}}"><span class="sr-only">Status: </span><a class="card-link" href="{{root}}index.html?status={{statusQv}}" data-filter="status" data-value="{{status}}">{{status}}</a></span><span class="card-type"><span class="sr-only">Policy type: </span><a class="card-link" href="{{root}}index.html?policy_type={{typeQv}}" data-filter="policy_type" data-value="{{policy_type}}">{{policyTypeLabel}}</a></span></p>
<p class="desc card-desc">{{summary}}</p>
<div class="card-tags">{{#tags}}<a class="chip tag card-tag" href="{{root}}index.html?tag={{qv}}" data-filter="tag" data-value="{{value}}">#{{value}}</a>{{/tags}}</div></div>
<div class="card-actions">{{#githubUrl}}<a class="card-btn card-btn-icon" href="{{{githubUrl}}}" target="_blank" rel="noopener noreferrer"><svg class="card-gh" viewBox="0 0 16 16" width="22" height="22" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg><span class="sr-only">View on Github (opens in a new tab)</span></a>{{/githubUrl}}{{^githubUrl}}<span class="card-btn card-btn-icon" aria-disabled="true"><svg class="card-gh" viewBox="0 0 16 16" width="22" height="22" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg><span class="sr-only">View on Github (unavailable)</span></span>{{/githubUrl}}
<span class="card-import"><button type="button" class="card-btn" disabled aria-describedby="import-note-{{id}}">Import to Guardian</button><span id="import-note-{{id}}" class="card-note">Coming soon<span class="sr-only">: importing into Guardian from this page is not available yet</span></span></span></div></li>
